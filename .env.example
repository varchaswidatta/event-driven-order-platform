# ==============================================================================
# Event-Driven Order Fulfillment Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides. Do NOT commit .env with real credentials.

NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Host-facing default: localhost
# Container-facing (inside Docker network): postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=local_password

# Dedicated logical databases (Database-per-Service)
ORDER_DB_NAME=order_db
INVENTORY_DB_NAME=inventory_db
STOCK_DB_NAME=stock_db

# ------------------------------------------------------------------------------
# Apache Kafka Streaming Configuration
# ------------------------------------------------------------------------------
# Host-facing default: localhost:9092
# Container-facing (inside Docker network): kafka:9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-service
KAFKA_GROUP_ID=order-service

# Transactional Outbox Configuration
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# Service Ports & Inter-Service Networking
# ------------------------------------------------------------------------------
# GraphQL API Gateway
API_GATEWAY_PORT=4000

# Order Service HTTP Server
ORDER_SERVICE_PORT=4001
# Host-facing: http://localhost:4001 | Container-facing: http://order-service:4001
ORDER_SERVICE_URL=http://localhost:4001

# Inventory Service
INVENTORY_SERVICE_PORT=4002

# Stock Service gRPC Server
# Host-facing: localhost | Container-facing: stock-service
STOCK_SERVICE_GRPC_HOST=localhost
STOCK_SERVICE_GRPC_PORT=50051
STOCK_SERVICE_TIMEOUT_MS=5000
